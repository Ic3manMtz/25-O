Silo_B <- c(4.4, 4.3, 3.4, 4.0, 3.8)
Silo_C <- c(3.3, 3.8, 3.6, 3.4, 3.8)
Silo_D <- c(6.6, 6.0, 6.2, 5.5, 5.6)
