# 2. Medidas importantes
Silo <- rep(c('A', 'B', 'C', 'D', 'E'), each = 5)
Dia <- rep(c('Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes'), 5)
Temperatura <- c(4.3, 4.0, 4.3, 3.8, 4.4,  # Silo A
4.4, 4.3, 3.4, 4.0, 3.8,  # Silo B
3.3, 3.8, 3.6, 3.4, 3.8,  # Silo C
6.6, 6.0, 6.2, 5.5, 5.6,  # Silo D
3.4, 4.4, 3.6, 3.8, 4.0)  # Silo E
DatosSilos <- data.frame(SILO = as.factor(Silo),
DIA = as.factor(Dia),
TEMP = Temperatura)
m <- length(unique(DatosSilos$SILO))  # Número de tratamientos
b <- length(unique(DatosSilos$DIA))   # Número de bloques
n_i <- b  # Número de datos por tratamiento
N <- nrow(DatosSilos)  # Total de datos
cat("Número de tratamientos (silos), m =", m, "\n")
cat("Número de bloques (días), b =", b, "\n")
cat("Número de datos en cada tratamiento, n_i =", n_i, "\n")
cat("Número total de datos, N =", N, "\n\n")
mA <- mean(Silo_A); mB <- mean(Silo_B); mC <- mean(Silo_C)
mD <- mean(Silo_D); mE <- mean(Silo_E)
vA <- var(Silo_A); vB <- var(Silo_B); vC <- var(Silo_C)
vD <- var(Silo_D); vE <- var(Silo_E)
cat("Medias muestrales",mA,mB,mC,mD,mE)
# 3. ANOVA
anovaSilos <- aov(TEMP ~ SILO + DIA, data = DatosSilos)
summary(anovaSilos)
# Sumas de cuadrados
SC_TRAT <- tabla_anova["SILO", "Sum Sq"]
resumen <- summary(anovaSilos)
tabla_anova <- resumen[[1]]
# Sumas de cuadrados
SC_TRAT <- tabla_anova["SILO", "Sum Sq"]
SC_BLOQ <- tabla_anova["DIA", "Sum Sq"]
SC_ERROR <- tabla_anova["Residuals", "Sum Sq"]
# Grados de libertad
gl_TRAT <- tabla_anova["SILO", "Df"]
gl_BLOQ <- tabla_anova["DIA", "Df"]
gl_ERROR <- tabla_anova["Residuals", "Df"]
# Cuadrados medios
CM_TRAT <- tabla_anova["SILO", "Mean Sq"]
CM_BLOQ <- tabla_anova["DIA", "Mean Sq"]
CM_ERROR <- tabla_anova["Residuals", "Mean Sq"]
# Estadísticos F
F_TRAT <- tabla_anova["SILO", "F value"]
F_BLOQ <- tabla_anova["DIA", "F value"]
# p-valores
p_valor_TRAT <- tabla_anova["SILO", "Pr(>F)"]
p_valor_BLOQ <- tabla_anova["DIA", "Pr(>F)"]
# 4. Decisión con alpha=0.01
alpha <- 0.01
cat("Para TRATAMIENTOS (Silos):\n")
if(p_valor_TRAT < alpha) {
cat("  Decisión: RECHAZAMOS H0\n")
cat("  Interpretación: Existe evidencia significativa de que al menos\n")
cat("  un silo tiene temperatura promedio diferente a los demás.\n\n")
rechazar_H0 <- TRUE
} else {
cat("  Decisión: NO RECHAZAMOS H0\n")
cat("  Interpretación: No hay evidencia suficiente para concluir\n")
cat("  que existen diferencias entre las temperaturas de los silos.\n\n")
rechazar_H0 <- FALSE
}
cat("Para BLOQUES (Días):\n")
if(p_valor_BLOQ < alpha) {
cat("  Decisión: RECHAZAMOS H0\n")
cat("  Interpretación: El día de la semana afecta significativamente\n")
cat("  la temperatura registrada.\n\n")
} else {
cat("  Decisión: NO RECHAZAMOS H0\n")
cat("  Interpretación: El día de la semana no afecta significativamente\n")
cat("  la temperatura registrada.\n\n")
}
# 5. Comparación LSD
lsd_alpha <- 0.05
t_critico <- qt(1 - alpha_lsd/2, gl_ERROR)
# 5. Comparación LSD
alpha_lsd <- 0.05
t_critico <- qt(1 - alpha_lsd/2, gl_ERROR)
l <- t_critico * sqrt(2 * CM_ERROR / b)
cat("Valores:\n")
cat("  α =", alpha_lsd, "\n")
cat("  α/2 =", alpha_lsd/2, "\n")
cat("  gl_error =", gl_ERROR, "\n")
cat("  t_(0.025, 16) =", round(t_critico, 4), "\n")
cat("  CM_ERROR =", round(CM_ERROR, 4), "\n")
cat("  b =", b, "\n\n")
cat("Sustituyendo:\n")
cat("  l =", round(t_critico, 4), "* √(2 *", round(CM_ERROR, 4), "/", b, ")\n")
cat("  l =", round(t_critico, 4), "* √(", round(2*CM_ERROR/b, 4), ")\n")
cat("  l =", round(t_critico, 4), "*", round(sqrt(2*CM_ERROR/b), 4), "\n")
cat("  l =", round(l, 4), "\n\n")
cat("Criterio de decisión: |X̄_i - X̄_j| >", round(l, 4),
"→ Los silos i y j son diferentes\n\n")
# Realizar todas las comparaciones por pares usando las medias ya calculadas
cat("Comparaciones por pares:\n")
cat(rep("-", 75), "\n", sep="")
cat(sprintf("%-15s %12s %12s %12s %15s\n", "Comparación", "X̄i", "X̄j", "|X̄i - X̄j|", "¿Diferentes?"))
cat(rep("-", 75), "\n", sep="")
# A vs B
diff_AB <- abs(mA - mB)
cat(sprintf("%-15s %12.4f %12.4f %12.4f %15s\n", "A vs B", mA, mB, diff_AB,
ifelse(diff_AB > l, "SÍ *", "No")))
# A vs C
diff_AC <- abs(mA - mC)
cat(sprintf("%-15s %12.4f %12.4f %12.4f %15s\n", "A vs C", mA, mC, diff_AC,
ifelse(diff_AC > l, "SÍ *", "No")))
# A vs D
diff_AD <- abs(mA - mD)
cat(sprintf("%-15s %12.4f %12.4f %12.4f %15s\n", "A vs D", mA, mD, diff_AD,
ifelse(diff_AD > l, "SÍ *", "No")))
# A vs E
diff_AE <- abs(mA - mE)
cat(sprintf("%-15s %12.4f %12.4f %12.4f %15s\n", "A vs E", mA, mE, diff_AE,
ifelse(diff_AE > l, "SÍ *", "No")))
# B vs C
diff_BC <- abs(mB - mC)
cat(sprintf("%-15s %12.4f %12.4f %12.4f %15s\n", "B vs C", mB, mC, diff_BC,
ifelse(diff_BC > l, "SÍ *", "No")))
# B vs D
diff_BD <- abs(mB - mD)
cat(sprintf("%-15s %12.4f %12.4f %12.4f %15s\n", "B vs D", mB, mD, diff_BD,
ifelse(diff_BD > l, "SÍ *", "No")))
# B vs E
diff_BE <- abs(mB - mE)
cat(sprintf("%-15s %12.4f %12.4f %12.4f %15s\n", "B vs E", mB, mE, diff_BE,
ifelse(diff_BE > l, "SÍ *", "No")))
# C vs D
diff_CD <- abs(mC - mD)
cat(sprintf("%-15s %12.4f %12.4f %12.4f %15s\n", "C vs D", mC, mD, diff_CD,
ifelse(diff_CD > l, "SÍ *", "No")))
# C vs E
diff_CE <- abs(mC - mE)
cat(sprintf("%-15s %12.4f %12.4f %12.4f %15s\n", "C vs E", mC, mE, diff_CE,
ifelse(diff_CE > l, "SÍ *", "No")))
# D vs E
diff_DE <- abs(mD - mE)
cat(sprintf("%-15s %12.4f %12.4f %12.4f %15s\n", "D vs E", mD, mE, diff_DE,
ifelse(diff_DE > l, "SÍ *", "No")))
cat(rep("-", 75), "\n", sep="")
cat("Valor crítico: l =", round(l, 4), "\n")
cat("* Indica diferencia significativa al nivel α = 0.05\n\n")
# Interpretación
cat("INTERPRETACIÓN:\n")
cat("Los silos que son significativamente diferentes entre sí son:\n")
if(diff_AB > l) cat(sprintf("  - Silo A (X̄ = %.4f) vs Silo B (X̄ = %.4f)\n", mA, mB))
if(diff_AC > l) cat(sprintf("  - Silo A (X̄ = %.4f) vs Silo C (X̄ = %.4f)\n", mA, mC))
if(diff_AD > l) cat(sprintf("  - Silo A (X̄ = %.4f) vs Silo D (X̄ = %.4f)\n", mA, mD))
if(diff_AE > l) cat(sprintf("  - Silo A (X̄ = %.4f) vs Silo E (X̄ = %.4f)\n", mA, mE))
if(diff_BC > l) cat(sprintf("  - Silo B (X̄ = %.4f) vs Silo C (X̄ = %.4f)\n", mB, mC))
if(diff_BD > l) cat(sprintf("  - Silo B (X̄ = %.4f) vs Silo D (X̄ = %.4f)\n", mB, mD))
if(diff_BE > l) cat(sprintf("  - Silo B (X̄ = %.4f) vs Silo E (X̄ = %.4f)\n", mB, mE))
if(diff_CD > l) cat(sprintf("  - Silo C (X̄ = %.4f) vs Silo D (X̄ = %.4f)\n", mC, mD))
if(diff_CE > l) cat(sprintf("  - Silo C (X̄ = %.4f) vs Silo E (X̄ = %.4f)\n", mC, mE))
if(diff_DE > l) cat(sprintf("  - Silo D (X̄ = %.4f) vs Silo E (X̄ = %.4f)\n", mD, mE))
# A vs B
lAB <- abs(mA-mB) / sqrt(2*CM_ERROR/b)
